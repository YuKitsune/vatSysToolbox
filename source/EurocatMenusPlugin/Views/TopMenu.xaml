<UserControl x:Class="EurocatMenusPlugin.Views.TopMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EurocatMenusPlugin.Views"
             xmlns:viewModels="clr-namespace:EurocatMenusPlugin.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             xmlns:controls="clr-namespace:vatSysToolbox.Controls;assembly=vatSysToolbox"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:TopMenuViewModel}"
             Height="96"
             d:DesignWidth="1920"
             Background="{toolbox:VatSysColour WindowBackground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Thickness x:Key="ItemMargin">2</Thickness>

            <!-- The height of the buttons, the text boxes, and the boxes -->
            <sys:Double x:Key="ControlHeight">24</sys:Double>

            <Style TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
                <Setter Property="MinWidth" Value="60" />
            </Style>

            <!-- The width of the functional state buttons and the label buttons -->
            <sys:Double x:Key="WideButtonWidth">72</sys:Double>

            <!-- A button that shows a value of a functional state (for example, the length of the velocity vectors) -->
            <Style x:Key="FunctionalStateButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
                <Setter Property="Width" Value="{StaticResource WideButtonWidth}" />
            </Style>

            <!-- A button that turns a functional state on or off (for example, VEL). It looks pressed while the state is on. -->
            <Style x:Key="FunctionalStateToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
                <Setter Property="Width" Value="{StaticResource WideButtonWidth}" />
            </Style>

            <!--
                A text box applies its value when Enter is pressed. If the text box loses the focus before Enter is
                pressed, it shows the old value again. The Text binding must use UpdateSourceTrigger=Explicit.
            -->
            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                <Setter Property="Height" Value="{StaticResource ControlHeight}" />
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="local:TextBoxBehaviours.CommitOnEnter" Value="True" />
            </Style>

            <!-- A box that shows a value. It has the same size and margin as a button. -->
            <Style x:Key="BoxStyle" TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{toolbox:VatSysColour GenericText}" />
                <Setter Property="Height" Value="{StaticResource ControlHeight}" />
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource GenericTextStyle}">
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="InteractiveLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
                <Setter Property="Foreground" Value="{toolbox:VatSysColour InteractiveText}" />
            </Style>

            <!--
                Large text. TextBaseStyle sets a fixed line height for the normal font size, and larger text goes outside
                that line. Thus, use the line height of the font.
                This style does not set the colour. Thus, in a button, the text gets the colour of the button.
            -->
            <Style x:Key="LargeTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
                <Setter Property="FontSize" Value="24" />
                <Setter Property="LineStackingStrategy" Value="MaxHeight" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <Style x:Key="SectionTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
            </Style>

            <Style x:Key="SectionSeparatorStyle" TargetType="controls:BeveledLine">
                <Setter Property="Orientation" Value="Vertical" />
                <Setter Property="Width" Value="2" />
            </Style>

            <Style x:Key="SectionStyle" TargetType="DockPanel">
                <Setter Property="Margin" Value="8,4" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Orientation="Horizontal">

        <!-- Connection and Position -->
        <!--
            The top and bottom margins are the same as SectionStyle. The first button is below its title, and the last
            button is at the bottom, as in the other sections.
        -->
        <Grid Margin="40,4,16,4">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}">Connection</TextBlock>
            <Button Grid.Row="1" VerticalAlignment="Center" Height="{StaticResource ControlHeight}" MinWidth="112" Command="{Binding OpenConnectionCommand}" Content="{Binding Connection}" />

            <TextBlock Grid.Row="3" Style="{StaticResource LabelStyle}">Position</TextBlock>
            <Button Grid.Row="4" VerticalAlignment="Center" Height="{StaticResource ControlHeight}" MinWidth="112" Click="PositionButton_Click" Content="{Binding PositionName}" />
        </Grid>

        <controls:BeveledLine Style="{StaticResource SectionSeparatorStyle}" />

        <!-- Visibility Centers and Airspace -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}">Visibility</TextBlock>
                <Button Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="{StaticResource ControlHeight}" Click="VisibilityCentersButton_Click" Content="{Binding VisibilityCentersMode}" />
                <TextBlock Grid.Row="3" Style="{StaticResource LabelStyle}">Airspace</TextBlock>
                <StackPanel Grid.Row="4" Orientation="Horizontal">
                    <Button VerticalAlignment="Center" Height="{StaticResource ControlHeight}" Command="{Binding OpenSectorsCommand}">SECTORS</Button>
                    <Button VerticalAlignment="Center" Height="{StaticResource ControlHeight}" Command="{Binding OpenRestrictedAreasCommand}">RESTR</Button>
                </StackPanel>
            </Grid>
        </DockPanel>

        <controls:BeveledLine Style="{StaticResource SectionSeparatorStyle}" />

        <!-- ATIS -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Style="{StaticResource SectionTitleStyle}">ATIS</TextBlock>
                <Button Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center" Height="{StaticResource ControlHeight}" Command="{Binding OpenAtisEditorCommand}" IsEnabled="{Binding IsAtisEditorAvailable}">EDITOR</Button>
                <Button Grid.Row="3" x:Name="AtisWindowButton" HorizontalAlignment="Center" VerticalAlignment="Center" Height="{StaticResource ControlHeight}" Click="AtisWindowButton_Click">WINDOW</Button>
            </Grid>
        </DockPanel>

        <!--
            Opens an ATIS window for an airport, or shows an ATIS window that is open.
            The same as Windows, ATIS in the vatSys menu bar.
        -->
        <Popup x:Name="AtisPopup" PlacementTarget="{Binding ElementName=AtisWindowButton}" Placement="Bottom" StaysOpen="False" Opened="AtisPopup_Opened">
            <Border Background="{toolbox:VatSysColour WindowBackground}">
                <controls:BeveledBorder BevelType="Raised" BorderThickness="{x:Static controls:Bevel.BorderThickness}">
                    <StackPanel>
                        <TextBox x:Name="AtisAirportTextBox"
                                 Width="64"
                                 MaxLength="4"
                                 CharacterCasing="Upper"
                                 local:TextBoxBehaviours.AllowedCharacters="[A-Za-z]"
                                 KeyDown="AtisAirportTextBox_KeyDown" />
                        <Separator x:Name="AtisWindowSeparator" Style="{StaticResource {x:Static MenuItem.SeparatorStyleKey}}" />
                        <StackPanel x:Name="AtisWindowList" />
                    </StackPanel>
                </controls:BeveledBorder>
            </Border>
        </Popup>

        <controls:BeveledLine Style="{StaticResource SectionSeparatorStyle}" />

        <!-- Main Window -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleStyle}">Main Window</TextBlock>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBox Width="50" MaxLength="4" local:TextBoxBehaviours.AllowedCharacters="[0-9]" Text="{Binding MainWindowRange, UpdateSourceTrigger=Explicit}" />
                <Border Style="{StaticResource BoxStyle}" Width="40"><TextBlock Style="{StaticResource LabelStyle}" Text="{Binding MainWindowStatus}" /></Border>
            </StackPanel>
        </DockPanel>

        <controls:BeveledLine Style="{StaticResource SectionSeparatorStyle}" />

        <!-- Second Window -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleStyle}">Second Window</TextBlock>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <TextBox Width="50" MaxLength="4" local:TextBoxBehaviours.AllowedCharacters="[0-9]" IsEnabled="{Binding IsSecondWindowOpen}" Text="{Binding SecondWindowRange, UpdateSourceTrigger=Explicit}" />
                <Border Style="{StaticResource BoxStyle}" Width="40"><TextBlock Style="{StaticResource LabelStyle}" Text="{Binding SecondWindowStatus}" /></Border>
            </StackPanel>
        </DockPanel>

        <controls:BeveledLine Style="{StaticResource SectionSeparatorStyle}" />

        <!-- Display Levels -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleStyle}">Display Levels</TextBlock>
            <Grid VerticalAlignment="Bottom">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBox Grid.Column="0" HorizontalAlignment="Center" Width="40" MaxLength="3" local:TextBoxBehaviours.AllowedCharacters="[0-9]" Text="{Binding LowerDisplayLevel, UpdateSourceTrigger=Explicit}" />
                <TextBox Grid.Column="1" HorizontalAlignment="Center" Width="40" MaxLength="3" local:TextBoxBehaviours.AllowedCharacters="[0-9]" Text="{Binding UpperDisplayLevel, UpdateSourceTrigger=Explicit}" />
            </Grid>
        </DockPanel>

        <controls:BeveledLine Style="{StaticResource SectionSeparatorStyle}" />

        <!-- SSR Code Filter -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleStyle}">SSR Code Filter</TextBlock>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom">
                <!-- SSR codes are octal -->
                <TextBox Width="32" MaxLength="2" local:TextBoxBehaviours.AllowedCharacters="[0-7]" Text="{Binding SsrCodeFilter1Start, UpdateSourceTrigger=Explicit}" />
                <TextBox Width="32" MaxLength="2" local:TextBoxBehaviours.AllowedCharacters="[0-7]" Text="{Binding SsrCodeFilter1End, UpdateSourceTrigger=Explicit}" />
                <TextBox Width="64" MaxLength="4" local:TextBoxBehaviours.AllowedCharacters="[0-7]" Text="{Binding SsrCodeFilter2Start, UpdateSourceTrigger=Explicit}" />
                <TextBox Width="64" MaxLength="4" local:TextBoxBehaviours.AllowedCharacters="[0-7]" Text="{Binding SsrCodeFilter2End, UpdateSourceTrigger=Explicit}" />
            </StackPanel>
        </DockPanel>

        <controls:BeveledLine Style="{StaticResource SectionSeparatorStyle}" />

        <!-- Time and Timer -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource InteractiveLabelStyle}" Margin="{StaticResource ItemMargin}">Time</TextBlock>
            <StackPanel Margin="4,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource LargeTextStyle}" Foreground="{toolbox:VatSysColour GenericText}" Text="{Binding Time}" />
                <TextBlock Style="{StaticResource InteractiveLabelStyle}">Timer</TextBlock>
                <Button Command="{Binding OpenTimeMenuCommand}">
                    <TextBlock Style="{StaticResource LargeTextStyle}" Text="{Binding Timer}" />
                </Button>
            </StackPanel>
        </DockPanel>

        <controls:BeveledLine Style="{StaticResource SectionSeparatorStyle}" />

        <!-- Functional States -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleStyle}">Functional States</TextBlock>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <!-- The same as ControlHeight -->
                    <RowDefinition Height="24" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Row="0" Grid.Column="0" Style="{StaticResource FunctionalStateToggleStyle}" Command="{Binding ToggleVelocityVectorsCommand}" IsChecked="{Binding IsVelocityVectorsOn, Mode=OneWay}">VEL</ToggleButton>
                <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FunctionalStateButtonStyle}" Click="VelocityVectorLengthButton_Click" Content="{Binding VelocityVectorLength}" />
                <ToggleButton Grid.Row="0" Grid.Column="1" Style="{StaticResource FunctionalStateToggleStyle}" Command="{Binding ToggleShortRouteProbeCommand}" IsChecked="{Binding IsShortRouteProbeOn, Mode=OneWay}">SRP</ToggleButton>
                <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource FunctionalStateButtonStyle}" Click="ShortRouteProbeLengthButton_Click" Content="{Binding ShortRouteProbeLength}" />
                <ToggleButton Grid.Row="0" Grid.Column="2" Style="{StaticResource FunctionalStateToggleStyle}" Command="{Binding ToggleHistoryDotsCommand}" IsChecked="{Binding IsHistoryDotsOn, Mode=OneWay}">HIST</ToggleButton>
                <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FunctionalStateButtonStyle}" Click="HistoryDotCountButton_Click" Content="{Binding HistoryDotCount}" />
            </Grid>
        </DockPanel>

        <DockPanel Style="{StaticResource SectionStyle}">
            <!-- This section has no title. The hidden title keeps the space, so the buttons line up with the other sections. -->
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleStyle}" Visibility="Hidden">Functional States</TextBlock>
            <Grid Margin="8,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ToggleButton Grid.Row="0" Grid.Column="0" Style="{StaticResource FunctionalStateToggleStyle}" Command="{Binding ToggleSsrAllCommand}" IsChecked="{Binding IsSsrAllOn, Mode=OneWay}">SSR ALL</ToggleButton>
                <ToggleButton Grid.Row="1" Grid.Column="0" Style="{StaticResource FunctionalStateToggleStyle}" Command="{Binding ToggleQuickLookAllCommand}" IsChecked="{Binding IsQuickLookAllOn, Mode=OneWay}">QLK ALL</ToggleButton>
                <ToggleButton Grid.Row="1" Grid.Column="1" Style="{StaticResource FunctionalStateToggleStyle}" Command="{Binding ToggleFpasdCommand}" IsChecked="{Binding IsFpasdOn, Mode=OneWay}">FPASD</ToggleButton>
            </Grid>
        </DockPanel>

        <!-- Space for one more column of functional state buttons: the button width (WideButtonWidth = 72) and its two margins (2) -->
        <FrameworkElement Width="76" />

        <!-- Label -->
        <DockPanel Style="{StaticResource SectionStyle}">
            <TextBlock DockPanel.Dock="Top" Style="{StaticResource SectionTitleStyle}">Label</TextBlock>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Row="0" Width="{StaticResource WideButtonWidth}" Command="{Binding ToggleExtendedLabelsCommand}" Content="{Binding LabelType}" />
                <Button Grid.Row="1" Width="{StaticResource WideButtonWidth}" Command="{Binding ToggleSharedLabelsCommand}" Content="{Binding LabelSharing}" />
            </Grid>
        </DockPanel>

    </StackPanel>
</UserControl>
