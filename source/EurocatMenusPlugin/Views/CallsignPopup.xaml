<UserControl x:Class="EurocatMenusPlugin.Views.CallsignPopup"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             xmlns:controls="clr-namespace:vatSysToolbox.Controls;assembly=vatSysToolbox"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <toolbox:SharedResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="CallsignPopupButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Height" Value="24" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!--
        The callsign at the top, and the buttons below it. The popup has a fixed width. There is no gap between the
        callsign, the sunken border, and the buttons.
    -->
    <StackPanel Width="80" Background="{toolbox:VatSysColour WindowBackground}">
        <Border BorderThickness="2" BorderBrush="{toolbox:VatSysColour GenericText}" Padding="4">
            <TextBlock x:Name="CallsignText" Style="{StaticResource GenericTextStyle}" HorizontalAlignment="Center" />
        </Border>

        <controls:BeveledBorder BevelType="Outline" BorderThickness="{x:Static controls:Bevel.BorderThickness}">
            <StackPanel x:Name="ButtonStack" />
        </controls:BeveledBorder>
    </StackPanel>
</UserControl>
