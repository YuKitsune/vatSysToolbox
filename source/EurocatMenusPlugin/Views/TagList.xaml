<UserControl x:Class="EurocatMenusPlugin.Views.TagList"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewModels="clr-namespace:EurocatMenusPlugin.ViewModels"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:TagListViewModel}"
             d:DesignHeight="150" d:DesignWidth="480"
             Background="{toolbox:VatSysColour WindowBackground}"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="StripTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
                <Setter Property="Foreground" Value="{toolbox:VatSysColour StripText}" />
                <!-- A transparent background makes all of the text get the mouse, and not only the characters -->
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer Style="{StaticResource CustomScrollViewerStyle}">
        <ItemsControl x:Name="StripList" ItemsSource="{Binding Items}">
            <ItemsControl.ItemContainerStyle>
                <Style>
                    <Setter Property="FrameworkElement.Margin" Value="2" />
                </Style>
            </ItemsControl.ItemContainerStyle>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="viewModels:TagListItemViewModel">
                    <Border
                        Background="{toolbox:VatSysColour StripBackground}"
                        BorderBrush="{toolbox:VatSysColour StripText}"
                        BorderThickness="2"
                        HorizontalAlignment="Left">
                        <!--
                            The minimum height is the height of the designator in the strips of the Hold plugin. Thus,
                            the strips of the two lists have the same height.
                        -->
                        <StackPanel Orientation="Horizontal" Margin="4" MinHeight="16">

                            <!-- ACID. A middle click deletes the quick tag. -->
                            <TextBlock Style="{StaticResource StripTextStyle}"
                                       Text="{Binding DisplayAircraftId}"
                                       MouseDown="Acid_MouseDown" />

                            <!-- SSR code and level -->
                            <TextBlock Style="{StaticResource StripTextStyle}"
                                       Text="{Binding DisplayCodeAndLevel}" />

                            <!-- Global ops. A click opens the text box. -->
                            <Grid MinWidth="120">
                                <TextBlock Text="{Binding GlobalOps}"
                                           MouseLeftButtonUp="GlobalOps_MouseLeftButtonUp">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource StripTextStyle}">
                                            <Style.Triggers>
                                                <!-- Hidden, and not collapsed, so that the strip keeps its size -->
                                                <DataTrigger Binding="{Binding IsEditingGlobalOps}" Value="True">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!--
                                    vatSys uses the same length and casing when the label data is edited on the ASD.
                                    The text box does not make the strip larger:
                                    - The negative margin puts the border of the text box in the space around the text.
                                    - The text box uses the same line height as the text of the strip. By default, a
                                      text box uses the line height of the font, which is larger.
                                -->
                                <TextBox Margin="-2"
                                         TextBlock.LineStackingStrategy="BlockLineHeight"
                                         TextBlock.LineHeight="{Binding Source={x:Static toolbox:VatSysFont.Size}, Converter={StaticResource FontSizeToLineHeightConverter}}"
                                         Text="{Binding GlobalOpsEditValue, UpdateSourceTrigger=PropertyChanged}"
                                         MaxLength="11"
                                         CharacterCasing="Upper"
                                         HorizontalAlignment="Stretch"
                                         LostFocus="GlobalOpsTextBox_LostFocus"
                                         IsVisibleChanged="GlobalOpsTextBox_IsVisibleChanged"
                                         MouseLeave="GlobalOpsTextBox_MouseLeave">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Return" Command="{Binding CommitGlobalOpsEditCommand}" />
                                        <KeyBinding Key="Escape" Command="{Binding CancelGlobalOpsEditCommand}" />
                                    </TextBox.InputBindings>
                                    <TextBox.Style>
                                        <Style TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditingGlobalOps}" Value="True">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBox.Style>
                                </TextBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
