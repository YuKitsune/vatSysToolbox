<UserControl x:Class="EurocatMenusPlugin.Views.BottomMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EurocatMenusPlugin.Views"
             xmlns:viewModels="clr-namespace:EurocatMenusPlugin.ViewModels"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:BottomMenuViewModel}"
             Height="56"
             d:DesignWidth="1920"
             Background="{toolbox:VatSysColour WindowBackground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Each item has a margin of 2, and the menu has a padding of 2.
                Thus, the gap between two items is the same as the gap between an item and the edge of the menu.
            -->
            <Thickness x:Key="ItemMargin">2</Thickness>
            <system:Double x:Key="ItemWidth">72</system:Double>

            <!-- A button that fills its space. Use it in a stack. -->
            <Style x:Key="StackedButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
            </Style>

            <!-- A square button with the full height of the menu -->
            <Style TargetType="Button" BasedOn="{StaticResource StackedButtonStyle}">
                <Setter Property="Width" Value="{StaticResource ItemWidth}" />
            </Style>

            <!-- A toggle button that fills its space. Use it in a stack. -->
            <Style x:Key="StackedToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
            </Style>

            <!--
                A square button that opens a popup or a window. It looks pressed while the popup or the window is open.
            -->
            <Style TargetType="ToggleButton" BasedOn="{StaticResource StackedToggleButtonStyle}">
                <Setter Property="Width" Value="{StaticResource ItemWidth}" />
            </Style>

            <!--
                The MSG button. While there are new messages, it flashes the same as Messages in the vatSys menu bar:
                the background changes between the warning colour and the window colour each 500 ms.
            -->
            <Style x:Key="MessagesButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource {x:Type ToggleButton}}">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasUnreadMessages}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="FlashStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Background" Duration="0:0:1">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{toolbox:VatSysColour WindowWarning}" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.5" Value="{toolbox:VatSysColour WindowBackground}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="FlashStoryboard" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                A stack of items with the full height of the menu.
                The stack has no margin, because its items have a margin. Thus, the stack is wider than a square button
                by two margins, and its items have the same width as a square button.
            -->
            <Style x:Key="StackStyle" TargetType="Grid">
                <Setter Property="Width" Value="{StaticResource ItemWidth}" />
            </Style>

            <!-- A border that is only as large as its content -->
            <Style x:Key="IndicatorStyle" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{toolbox:VatSysColour GenericText}" />
            </Style>

            <Style x:Key="GenericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
                <Setter Property="Foreground" Value="{toolbox:VatSysColour GenericText}" />
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <StackPanel Orientation="Horizontal" Margin="{StaticResource ItemMargin}">
        <ToggleButton Click="SetUpButton_Click">Set Up</ToggleButton>
        <ToggleButton Click="MapButton_Click">Map</ToggleButton>
        <!-- IRL, this opens a window we can't simulate. Just open the built-in Info menu for simplicity -->
        <ToggleButton Click="InfoButton_Click">Info</ToggleButton>
        <Grid Style="{StaticResource StackStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <!-- IRL, this opens the second ASD window. vatSys supports multiple, so this just opens another Air window -->
            <Button Grid.Row="0" Style="{StaticResource StackedButtonStyle}" Command="{Binding OpenAirWindowCommand}">Air</Button>
            <!-- IRL, this opens the Sup ASD, which we don't simulate. Open a Ground window instead -->
            <Button Grid.Row="1" Style="{StaticResource StackedButtonStyle}" Command="{Binding OpenGroundWindowCommand}">Ground</Button>
        </Grid>
        <Button Command="{Binding OpenFlightPlanCommand}">FPL</Button>
        <ToggleButton Command="{Binding ToggleHoldSetupCommand}" IsChecked="{Binding IsHoldSetupOpen, Mode=OneWay}" IsEnabled="{Binding IsHoldSetupAvailable}">HLD SET</ToggleButton>
        <Grid Style="{StaticResource StackStyle}">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <ToggleButton Grid.Row="0" Style="{StaticResource StackedToggleButtonStyle}" Command="{Binding ToggleStripSetupCommand}" IsChecked="{Binding IsStripSetupOpen, Mode=OneWay}">SSTP</ToggleButton>
            <Border Grid.Row="1" Style="{StaticResource IndicatorStyle}">
                <TextBlock Style="{StaticResource GenericTextStyle}" HorizontalAlignment="Center" Text="{Binding StripSortMode}" />
            </Border>
        </Grid>
        <Button IsEnabled="False">Lost</Button>
        <ToggleButton Click="TfmsButton_Click" IsEnabled="{Binding IsTfmsAvailable}">TFMS</ToggleButton>
        
        <!-- Traffic management window not simulated -->
        <!-- <Button IsEnabled="False">TFC MGT</Button> -->
        
        <!-- Coordination Queue not simulated -->
        <!-- <Grid Style="{StaticResource StackStyle}"> -->
        <!--     <Grid.RowDefinitions> -->
        <!--         <RowDefinition Height="*" /> -->
        <!--         <RowDefinition Height="*" /> -->
        <!--     </Grid.RowDefinitions> -->
        <!--     <Button Grid.Row="0" Style="{StaticResource StackedButtonStyle}" IsEnabled="False">CQ</Button> -->
        <!--     <Border Grid.Row="1" Style="{StaticResource IndicatorStyle}"> -->
        <!--         <TextBlock Style="{StaticResource GenericTextStyle}" HorizontalAlignment="Center">0</TextBlock> -->
        <!--     </Border> -->
        <!-- </Grid> -->
        
        <ToggleButton Command="{Binding ToggleAdsContractCommand}" IsChecked="{Binding IsAdsContractOpen, Mode=OneWay}" IsEnabled="{Binding IsAdsContractAvailable}">ADS Contract</ToggleButton>
        <ToggleButton Command="{Binding ToggleCpdlcHistoryCommand}" IsChecked="{Binding IsCpdlcHistoryOpen, Mode=OneWay}" IsEnabled="{Binding IsCpdlcHistoryAvailable}">History CPDLC</ToggleButton>
        
        <!-- Waypoint discrepancy not simulated -->
        <!-- <Button IsEnabled="False">WAYP</Button> -->
        
        <Button IsEnabled="False">Tag List</Button>
        <Button Command="{Binding RemoveQuickTagCommand}">Del Tag</Button>
        <Button Command="{Binding AddQuickTagCommand}">Rad Tag</Button>
        <Button Command="{Binding ToggleLateralConflictToolCommand}">LATC</Button>
        
        <!-- VATSIM-isms -->
        <ToggleButton Style="{StaticResource MessagesButtonStyle}" Click="MessagesButton_Click">MSG</ToggleButton>
        <ToggleButton Click="AtisButton_Click">ATIS</ToggleButton>
        <Button Command="{Binding OpenSelcalCommand}">SELCAL</Button>

    </StackPanel>
</UserControl>
