<UserControl x:Class="EurocatMenusPlugin.Views.BottomMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:EurocatMenusPlugin.Views"
             xmlns:viewModels="clr-namespace:EurocatMenusPlugin.ViewModels"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=viewModels:BottomMenuViewModel}"
             Height="56"
             d:DesignWidth="1920"
             Background="{toolbox:VatSysColour WindowBackground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                Each item has a margin of 2, and the menu has a padding of 2.
                Thus, the gap between two items is the same as the gap between an item and the edge of the menu.
            -->
            <Thickness x:Key="ItemMargin">2</Thickness>
            <system:Double x:Key="ItemWidth">72</system:Double>

            <!-- A button that fills its space. Use it in a stack. -->
            <Style x:Key="StackedButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
            </Style>

            <!-- A square button with the full height of the menu -->
            <Style TargetType="Button" BasedOn="{StaticResource StackedButtonStyle}">
                <Setter Property="Width" Value="{StaticResource ItemWidth}" />
            </Style>

            <!-- A toggle button that fills its space. Use it in a stack. -->
            <Style x:Key="StackedToggleButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
                <Setter Property="Margin" Value="{StaticResource ItemMargin}" />
            </Style>

            <!--
                A square button that opens a popup or a window. It looks pressed while the popup or the window is open.
            -->
            <Style TargetType="ToggleButton" BasedOn="{StaticResource StackedToggleButtonStyle}">
                <Setter Property="Width" Value="{StaticResource ItemWidth}" />
            </Style>

            <!-- A border that is only as large as its content -->
            <Style x:Key="IndicatorStyle" TargetType="Border">
                <Setter Property="Width" Value="24" />
                <Setter Property="Height" Value="24" />
                <Setter Property="HorizontalAlignment" Value="Center" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{toolbox:VatSysColour GenericText}" />
            </Style>

            <Style x:Key="GenericTextStyle" TargetType="TextBlock" BasedOn="{StaticResource TextBaseStyle}">
                <Setter Property="Foreground" Value="{toolbox:VatSysColour GenericText}" />
            </Style>

            <!-- The templates of the items. The bottom menu shows each item with the template of its type. -->

            <DataTemplate DataType="{x:Type viewModels:ButtonViewModel}">
                <Button Content="{Binding Text}" Command="{Binding ClickCommand}" />
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:ToggleButtonViewModel}">
                <ToggleButton Content="{Binding Text}"
                              Command="{Binding ClickCommand}"
                              IsChecked="{Binding IsChecked, Mode=OneWay}"
                              IsEnabled="{Binding IsEnabled}" />
            </DataTemplate>

            <!--
                While the button flashes, the background changes between the warning colour and the window colour each
                500 ms, the same as Messages in the vatSys menu bar.
            -->
            <DataTemplate DataType="{x:Type viewModels:PopupButtonViewModel}">
                <ToggleButton x:Name="Button"
                              Content="{Binding Text}"
                              IsEnabled="{Binding IsEnabled}"
                              Click="PopupButton_Click" />
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsFlashing}" Value="True">
                        <DataTrigger.EnterActions>
                            <BeginStoryboard x:Name="FlashStoryboard">
                                <Storyboard RepeatBehavior="Forever">
                                    <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Button" Storyboard.TargetProperty="Background" Duration="0:0:1">
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{toolbox:VatSysColour WindowWarning}" />
                                        <DiscreteObjectKeyFrame KeyTime="0:0:0.5" Value="{toolbox:VatSysColour WindowBackground}" />
                                    </ObjectAnimationUsingKeyFrames>
                                </Storyboard>
                            </BeginStoryboard>
                        </DataTrigger.EnterActions>
                        <DataTrigger.ExitActions>
                            <StopStoryboard BeginStoryboardName="FlashStoryboard" />
                        </DataTrigger.ExitActions>
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <DataTemplate DataType="{x:Type viewModels:IndicatorViewModel}">
                <Border Style="{StaticResource IndicatorStyle}">
                    <TextBlock Style="{StaticResource GenericTextStyle}" HorizontalAlignment="Center" Text="{Binding Text}" />
                </Border>
            </DataTemplate>

            <!--
                The items of a stack share the full height of the menu.
                The stack has no margin, because its items have a margin. Thus, the stack is wider than a square button
                by two margins, and its items have the same width as a square button.
            -->
            <DataTemplate DataType="{x:Type viewModels:StackViewModel}">
                <ItemsControl ItemsSource="{Binding Items}" Width="{StaticResource ItemWidth}">
                    <ItemsControl.Resources>
                        <!-- The buttons in a stack fill their space -->
                        <Style TargetType="Button" BasedOn="{StaticResource StackedButtonStyle}" />
                        <Style TargetType="ToggleButton" BasedOn="{StaticResource StackedToggleButtonStyle}" />
                    </ItemsControl.Resources>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="1" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>
    <ItemsControl ItemsSource="{Binding Items}" Margin="{StaticResource ItemMargin}">
        <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
    </ItemsControl>
</UserControl>
