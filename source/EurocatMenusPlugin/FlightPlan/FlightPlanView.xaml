<UserControl x:Class="EurocatMenusPlugin.FlightPlan.FlightPlanView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:local="clr-namespace:EurocatMenusPlugin.FlightPlan"
             xmlns:views="clr-namespace:EurocatMenusPlugin.Views"
             xmlns:toolbox="clr-namespace:vatSysToolbox;assembly=vatSysToolbox"
             xmlns:controls="clr-namespace:vatSysToolbox.Controls;assembly=vatSysToolbox"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=local:FlightPlanViewModel}"
             Background="{toolbox:VatSysColour WindowBackground}"
             Focusable="True"
             KeyDown="View_KeyDown">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <toolbox:SharedResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- The function buttons in the grid at the top -->
            <sys:Double x:Key="ButtonWidth">52</sys:Double>
            <sys:Double x:Key="ButtonHeight">32</sys:Double>

            <!-- The buttons in the bottom row, and the RTE button -->
            <sys:Double x:Key="WideButtonWidth">64</sys:Double>
            <sys:Double x:Key="WideButtonHeight">26</sys:Double>

            <!-- The height of a single-line field -->
            <sys:Double x:Key="ControlHeight">24</sys:Double>

            <!-- The space between the groups of function buttons -->
            <GridLength x:Key="GroupGap">10</GridLength>

            <!-- The space before a label that follows a field -->
            <Thickness x:Key="PairMargin">8,0,0,0</Thickness>

            <!--
                The buttons never take the keyboard focus. Thus, Enter and Escape go to the view, and a click on a
                button does not take the focus from the field that the user types in.
            -->
            <Style x:Key="FunctionButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Width" Value="{StaticResource ButtonWidth}" />
                <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- A mode button (CRE, MOD, DEP). It looks pressed while the mode is on. -->
            <Style x:Key="FunctionToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource ToggleButtonBaseStyle}">
                <Setter Property="Width" Value="{StaticResource ButtonWidth}" />
                <Setter Property="Height" Value="{StaticResource ButtonHeight}" />
                <Setter Property="Margin" Value="1" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <Style x:Key="WideButtonStyle" TargetType="Button" BasedOn="{StaticResource ButtonBaseStyle}">
                <Setter Property="Width" Value="{StaticResource WideButtonWidth}" />
                <Setter Property="Height" Value="{StaticResource WideButtonHeight}" />
                <Setter Property="Margin" Value="2" />
                <Setter Property="Focusable" Value="False" />
            </Style>

            <!-- The labels before the fields. The text is dark blue, whatever the state of the field. -->
            <Style x:Key="LabelStyle" TargetType="TextBlock" BasedOn="{StaticResource InteractiveTextStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>

            <!-- The labels in the button grid (the counter, the state, and the update time) -->
            <Style x:Key="CentredLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource LabelStyle}">
                <Setter Property="TextAlignment" Value="Center" />
                <Setter Property="HorizontalAlignment" Value="Center" />
            </Style>

            <!--
                A data field. An editable field has a sunken bevel, and the vatSys focus outline while it has the
                keyboard focus. A display-only field has the thin outline of the boxes in the menus, and it ignores the
                mouse. The same scroll viewer holds the text in both states, so that the scroll bar of a multi-line
                field keeps working when the field changes state.
            -->
            <ControlTemplate x:Key="FieldTemplate" TargetType="TextBox">
                <Grid Background="{TemplateBinding Background}">
                    <Border
                        x:Name="Outline"
                        BorderThickness="1"
                        BorderBrush="{toolbox:VatSysColour GenericText}"
                        Visibility="Collapsed" />
                    <controls:BeveledBorder
                        x:Name="Bevel"
                        BorderThickness="{x:Static controls:Bevel.BorderThickness}"
                        BevelType="Sunken" />
                    <ScrollViewer x:Name="PART_ContentHost" Margin="2" />

                    <!--
                        vatSys draws this outline around a text field that has the keyboard focus. The negative margin
                        puts the outline outside the field, so that it does not cover the bevel.
                    -->
                    <Border
                        x:Name="FocusOutline"
                        Margin="-2"
                        BorderThickness="2"
                        BorderBrush="{toolbox:VatSysColour HighlightedText}"
                        IsHitTestVisible="False"
                        Visibility="Collapsed" />
                </Grid>

                <ControlTemplate.Triggers>
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter TargetName="Bevel" Property="Visibility" Value="Collapsed" />
                        <Setter TargetName="Outline" Property="Visibility" Value="Visible" />
                    </Trigger>
                    <MultiTrigger>
                        <MultiTrigger.Conditions>
                            <Condition Property="IsKeyboardFocused" Value="True" />
                            <Condition Property="IsReadOnly" Value="False" />
                        </MultiTrigger.Conditions>
                        <Setter TargetName="FocusOutline" Property="Visibility" Value="Visible" />
                    </MultiTrigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- The DataContext of a field is its FieldViewModel -->
            <Style x:Key="FieldStyle" TargetType="TextBox" BasedOn="{StaticResource TextBoxBaseStyle}">
                <Setter Property="Height" Value="{StaticResource ControlHeight}" />
                <Setter Property="Margin" Value="2,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="CharacterCasing" Value="Upper" />
                <Setter Property="Background" Value="{toolbox:VatSysColour WindowBackground}" />
                <Setter Property="Template" Value="{StaticResource FieldTemplate}" />
                <Setter Property="Text" Value="{Binding Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Setter Property="MaxLength" Value="{Binding MaxLength}" />
                <Setter Property="IsReadOnly" Value="{Binding IsReadOnly}" />
                <Setter Property="views:TextBoxBehaviours.AllowedCharacters" Value="{Binding AllowedCharacters}" />

                <Style.Triggers>
                    <!-- A display-only field never takes the focus, and ignores the mouse -->
                    <Trigger Property="IsReadOnly" Value="True">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="IsHitTestVisible" Value="False" />
                    </Trigger>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Background" Value="{toolbox:VatSysColour WindowWarning}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- RTE and OTHER. The field shows a fixed number of lines, and a scroll bar beside it scrolls the text. -->
            <Style x:Key="MultilineFieldStyle" TargetType="TextBox" BasedOn="{StaticResource FieldStyle}">
                <Setter Property="Height" Value="{x:Static sys:Double.NaN}" />
                <Setter Property="Padding" Value="0,1" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="AcceptsReturn" Value="False" />
                <Setter Property="VerticalContentAlignment" Value="Top" />
                <Setter Property="VerticalAlignment" Value="Stretch" />
                <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
            </Style>

            <!-- The message area. It has the warning colour while it shows an error. -->
            <Style x:Key="MessageAreaStyle" TargetType="Border">
                <Setter Property="Background" Value="{toolbox:VatSysColour WindowBackground}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding HasError}" Value="True">
                        <Setter Property="Background" Value="{toolbox:VatSysColour WindowWarning}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="8">

        <!--
            Function buttons. This is the widest row. The window measures the view with no width limit, thus the code
            behind gives the rows that wrap text (RTE, OTHER, and the message area) the width of this row, so that
            they wrap instead of making the window wider.
        -->
        <Grid x:Name="ButtonGrid" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <!-- paging -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource GroupGap}" />
                <!-- plan handling -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource GroupGap}" />
                <!-- control -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource GroupGap}" />
                <!-- coupling -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource GroupGap}" />
                <!-- misc (no vatSys equivalent) -->
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="{StaticResource GroupGap}" />
                <!-- update time -->
                <ColumnDefinition Width="96" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Paging. vatSys shows one flight plan in each window. -->
            <Button Grid.Row="0" Grid.Column="0" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="NEXT" />
            <Button Grid.Row="1" Grid.Column="0" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="PREV" />
            <TextBlock Grid.Row="2" Grid.Column="0" Style="{StaticResource CentredLabelStyle}" Text="{Binding Counter}" />

            <!-- Plan handling -->
            <ToggleButton Grid.Row="0" Grid.Column="2" Style="{StaticResource FunctionToggleStyle}" Command="{Binding CreateCommand}" IsChecked="{Binding IsCreateSelected, Mode=OneWay}" Content="CRE" />
            <Button Grid.Row="0" Grid.Column="3" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="RPL" />
            <Button Grid.Row="0" Grid.Column="4" Style="{StaticResource FunctionButtonStyle}" Command="{Binding EstimateCommand}" Content="EST" />
            <Button Grid.Row="0" Grid.Column="5" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="HOLD" />
            <Button Grid.Row="1" Grid.Column="2" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="CRTE" />
            <Button Grid.Row="1" Grid.Column="3" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="STE" />
            <ToggleButton Grid.Row="1" Grid.Column="4" Style="{StaticResource FunctionToggleStyle}" Command="{Binding ModifyCommand}" IsChecked="{Binding IsModifySelected, Mode=OneWay}" Content="MOD" />
            <Button Grid.Row="1" Grid.Column="5" Style="{StaticResource FunctionButtonStyle}" Command="{Binding BackCommand}" Content="BACK" />
            <TextBlock Grid.Row="2" Grid.Column="2" Style="{StaticResource CentredLabelStyle}" Text="{Binding FlightPlanState}" />
            <Button Grid.Row="2" Grid.Column="3" Style="{StaticResource FunctionButtonStyle}" Command="{Binding PrlCommand}" Content="PRL" />
            <Button Grid.Row="2" Grid.Column="4" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="TMA" />
            <Button Grid.Row="2" Grid.Column="5" Style="{StaticResource FunctionButtonStyle}" Command="{Binding CflCommand}" Content="CFL" />

            <!-- Control -->
            <ToggleButton Grid.Row="0" Grid.Column="7" Style="{StaticResource FunctionToggleStyle}" Command="{Binding DepartCommand}" IsChecked="{Binding IsDepartSelected, Mode=OneWay}" Content="DEP" />
            <Button Grid.Row="0" Grid.Column="8" Style="{StaticResource FunctionButtonStyle}" Command="{Binding AcceptCommand}" Content="ACC" />
            <Button Grid.Row="0" Grid.Column="9" Style="{StaticResource FunctionButtonStyle}" Command="{Binding CancelCommand}" Content="CNL" />
            <Button Grid.Row="1" Grid.Column="7" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="CBEP" />
            <Button Grid.Row="1" Grid.Column="8" Style="{StaticResource FunctionButtonStyle}" Command="{Binding HandoffCommand}" Content="HND" />
            <Button Grid.Row="1" Grid.Column="9" Style="{StaticResource FunctionButtonStyle}" Command="{Binding InhibitCommand}" Content="INHI" />
            <Button Grid.Row="2" Grid.Column="7" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="EXIT" />
            <Button Grid.Row="2" Grid.Column="8" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="HND/I" />
            <Button Grid.Row="2" Grid.Column="9" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="SUP" />

            <!-- Coupling -->
            <Button Grid.Row="0" Grid.Column="11" Style="{StaticResource FunctionButtonStyle}" Command="{Binding DecoupleCommand}" Content="NCOU" />
            <Button Grid.Row="1" Grid.Column="11" Style="{StaticResource FunctionButtonStyle}" Command="{Binding CoupleCommand}" Content="BCOU" />

            <!-- Misc. vatSys has no function for these, thus they are not available. -->
            <Button Grid.Row="0" Grid.Column="13" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="TRS" />
            <Button Grid.Row="0" Grid.Column="14" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="JTRT" />
            <Button Grid.Row="1" Grid.Column="13" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="AUR" />
            <Button Grid.Row="1" Grid.Column="14" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="PRINT&#10;STRIP" />
            <Button Grid.Row="2" Grid.Column="13" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="CMC" />
            <Button Grid.Row="2" Grid.Column="14" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="FMF" />

            <!-- Update time -->
            <StackPanel Grid.Row="0" Grid.RowSpan="2" Grid.Column="16" VerticalAlignment="Top" Margin="0,2,0,0">
                <TextBlock Style="{StaticResource CentredLabelStyle}" Text="Update Time" />
                <TextBlock Style="{StaticResource CentredLabelStyle}" Text="{Binding UpdateTime}" />
            </StackPanel>
            <Button Grid.Row="2" Grid.Column="16" Style="{StaticResource FunctionButtonStyle}" IsEnabled="False" Content="PRINT&#10;FDR" />
        </Grid>

        <!-- The separators go to the edges of the window -->
        <controls:BeveledLine Height="2" Margin="-8,6" />

        <!-- System data -->
        <StackPanel Orientation="Horizontal">
            <TextBlock Style="{StaticResource LabelStyle}" Text="LPL" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Lpl}" Width="{local:Characters 3}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="CSEC" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Csec}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="PSSR" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Pssr}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="ASSR" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Assr}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="OPDATA" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Opdata}" Width="{local:Characters 10}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="ATD" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Atd}" Width="{local:Characters 4}" />
        </StackPanel>

        <!-- Flight data. This row is a little to the right of the rows above and below it, as in the Eurocat window. -->
        <StackPanel Orientation="Horizontal" Margin="16,2,0,0">
            <TextBlock Style="{StaticResource LabelStyle}" Text="ACID" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Acid}" Width="{local:Characters 7}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="FRUL" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Frul}" Width="{local:Characters 1}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="TYP" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Typ1}" Width="{local:Characters 2}" />
            <TextBlock Style="{StaticResource LabelStyle}" Text="/" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Typ2}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Text="/" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Typ3}" Width="{local:Characters 1}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="ADEP" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Adep}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="ETD" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Etd}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="ADES" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Ades}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="RFL" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Rfl}" Width="{local:Characters 3}" />
        </StackPanel>

        <!-- Route -->
        <Grid x:Name="RouteRow" Margin="0,6,0,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource WideButtonStyle}" Width="44" HorizontalAlignment="Left" VerticalAlignment="Top" Command="{Binding ToggleRouteCommand}" Content="RTE" />
            <TextBox Grid.Column="1" x:Name="RteBox" Style="{StaticResource MultilineFieldStyle}" DataContext="{Binding Rte}" MinLines="3" MaxLines="3" />
            <controls:CustomScrollBar Grid.Column="2" x:Name="RteScrollBar" Width="21" Margin="2,0,0,0" />
        </Grid>

        <!-- Remarks -->
        <Grid x:Name="RemarksRow" Margin="0,4,0,0" HorizontalAlignment="Left">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="54" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource LabelStyle}" VerticalAlignment="Top" Margin="0,4,0,0" Text="OTHER" />
            <TextBox Grid.Column="1" x:Name="OtherBox" Style="{StaticResource MultilineFieldStyle}" DataContext="{Binding Other}" MinLines="2" MaxLines="2" />
            <controls:CustomScrollBar Grid.Column="2" x:Name="OtherScrollBar" Width="21" Margin="2,0,0,0" />
        </Grid>

        <!-- Equipment -->
        <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Style="{StaticResource LabelStyle}" Text="FTYP" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Ftyp}" Width="{local:Characters 1}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="EQUIP" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Equip1}" Width="{local:Characters 10}" />
            <TextBlock Style="{StaticResource LabelStyle}" Text="/" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Equip2}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="TAS" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Tas}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="EET" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Eet}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="ALTN" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Altn1}" Width="{local:Characters 4}" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Altn2}" Width="{local:Characters 4}" />
            <TextBlock Style="{StaticResource LabelStyle}" Margin="{StaticResource PairMargin}" Text="REGN" />
            <TextBox Style="{StaticResource FieldStyle}" DataContext="{Binding Regn}" Width="{local:Characters 7}" />
        </StackPanel>

        <!-- Message area: two lines -->
        <Border x:Name="MessageArea" Style="{StaticResource MessageAreaStyle}" Height="40" Margin="0,8,0,0" Padding="4,0" HorizontalAlignment="Left">
            <TextBlock Style="{StaticResource LabelStyle}" Text="{Binding ErrorMessage}" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center" />
        </Border>

        <controls:BeveledLine Height="2" Margin="-8,6" />

        <!-- Bottom row -->
        <Grid Margin="0,2,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="4,0,0,0">
                <Button Style="{StaticResource WideButtonStyle}" Command="{Binding ClearCommand}" Content="Clear" />
                <Button Style="{StaticResource WideButtonStyle}" Margin="90,2,2,2" IsEnabled="False" Content="TPCF" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,4,0">
                <Button Style="{StaticResource WideButtonStyle}" Command="{Binding EnterCommand}" Content="Enter" />
                <Button Style="{StaticResource WideButtonStyle}" Margin="6,2,2,2" Command="{Binding EscapeCommand}" Content="Escape" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
