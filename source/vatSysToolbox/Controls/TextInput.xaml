<UserControl x:Class="vatSysToolbox.Controls.TextInput"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:vatSysToolbox"
             xmlns:controls="clr-namespace:vatSysToolbox.Controls"
             mc:Ignorable="d"
             d:DesignWidth="64"
             Height="24"
             Background="{local:VatSysColour WindowBackground}">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/vatSysToolbox;component/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            
            <Style x:Key="TextBoxStyle" TargetType="TextBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Padding" Value="0"/>
                <Setter Property="Margin" Value="0"/>
                <Setter Property="TextWrapping" Value="NoWrap"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="HorizontalContentAlignment" Value="Left"/>
                <Setter Property="Foreground" Value="{local:VatSysColour InteractiveText}"/>
                <Setter Property="FontFamily" Value="{x:Static local:VatSysFont.Family}"/>
                <Setter Property="FontSize" Value="{x:Static local:VatSysFont.Size}"/>
                <Setter Property="FontWeight" Value="{x:Static local:VatSysFont.Weight}"/>

                <Style.Triggers>
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Foreground" Value="{local:VatSysColour GenericText}"/>
                        <Setter Property="Opacity" Value="1"/>
                    </Trigger>
                </Style.Triggers>
                
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>
    <Grid>
        <controls:BeveledBorder BorderThickness="{x:Static controls:Bevel.BorderThickness}" BevelType="Sunken">
            <TextBox x:Name="InputBox"
                     Style="{StaticResource TextBoxStyle}"
                     PreviewTextInput="InputBox_PreviewTextInput"
                     TextChanged="InputBox_TextChanged"
                     Text="{Binding Text, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     IsEnabled="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=UserControl}}"
                     MaxLength="{Binding MaxCharacters, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
        </controls:BeveledBorder>

        <!-- vatSys draws this outline over the border of a text field that has the keyboard focus -->
        <Border BorderThickness="2" BorderBrush="{local:VatSysColour HighlightedText}" IsHitTestVisible="False">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsKeyboardFocused, ElementName=InputBox}" Value="True" />
                                <Condition Binding="{Binding IsReadOnly, ElementName=InputBox}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter Property="Visibility" Value="Visible" />
                        </MultiDataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
        </Border>
    </Grid>
</UserControl>
