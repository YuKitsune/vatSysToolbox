<UserControl x:Class="vatSysToolbox.Controls.CustomScrollBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:vatSysToolbox.Controls"
             xmlns:local="clr-namespace:vatSysToolbox"
             mc:Ignorable="d" 
             Loaded="UserControl_Loaded">
    
    <!-- Single beveled border containing all scrollbar elements -->
    <controls:BeveledBorder
        BevelType="Sunken"
        BorderThickness="{x:Static controls:Bevel.BorderThickness}">
        <Border Background="{local:VatSysColour WindowButtonSelected}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Scroll up button area. The buttons are square, the same as in vatSys. -->
                <Border
                    Grid.Row="0"
                    x:Name="PART_ScrollUpButton"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                    Background="Transparent">
                    <controls:Chevron
                        Direction="Up"
                        Width="11"
                        Foreground="{local:VatSysColour WindowBackground}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <!-- Scroll track area -->
                <Grid Grid.Row="1" x:Name="PART_Track" Background="Transparent">
                    <!-- Scroll thumb with gray background for beveling -->
                    <Border
                        x:Name="PART_Thumb"
                        Background="{local:VatSysColour WindowBackground}"
                        Height="20"
                        VerticalAlignment="Top"
                        Margin="1">
                        <controls:BeveledBorder
                            BevelType="Raised"
                            BorderThickness="{x:Static controls:Bevel.BorderThickness}">
                            <Border Background="{local:VatSysColour WindowBackground}" />
                        </controls:BeveledBorder>
                    </Border>
                </Grid>

                <!-- Scroll down button area -->
                <Border
                    Grid.Row="2"
                    x:Name="PART_ScrollDownButton"
                    Height="{Binding ActualWidth, RelativeSource={RelativeSource Self}}"
                    Background="Transparent">
                    <controls:Chevron
                        Direction="Down"
                        Width="11"
                        Foreground="{local:VatSysColour WindowBackground}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>
    </controls:BeveledBorder>
</UserControl>