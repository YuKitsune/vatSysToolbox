<UserControl x:Class="vatSysToolbox.Controls.CustomScrollBar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="clr-namespace:vatSysToolbox.Controls"
             xmlns:local="clr-namespace:vatSysToolbox"
             mc:Ignorable="d" 
             d:DesignHeight="80"
             Loaded="UserControl_Loaded">
    
    <!-- Single beveled border containing all scrollbar elements -->
    <controls:BeveledBorder
        BevelType="Sunken"
        BorderThickness="{x:Static controls:Bevel.BorderThickness}">
        <Border Background="{local:VatSysColour WindowButtonSelected}" Padding="1">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="14"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="14"/>
                </Grid.RowDefinitions>

                <!--
                    Scroll up button area. The sizes and the positions are the same as in vatSys. With the padding and
                    the margin of the track, each button is 16 x 16. The chevrons are 13 x 13, 2 pixels from the
                    top and the left of the up button, and 1 pixel from the bottom of the down button.
                -->
                <controls:Chevron
                    Grid.Row="0"
                    x:Name="PART_ScrollUpButton"
                    Width="13"
                    Height="13"
                    Margin="1,1,0,0"
                    Direction="Up"
                    Foreground="{local:VatSysColour WindowBackground}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top" />

                <!-- Scroll track area -->
                <Grid Grid.Row="1" x:Name="PART_Track" Background="Transparent" Margin="0,1,0,1">
                    <!-- Scroll thumb with gray background for beveling -->
                    <Border
                        x:Name="PART_Thumb"
                        Background="{local:VatSysColour WindowBackground}"
                        Height="20"
                        VerticalAlignment="Top">
                        <controls:BeveledBorder
                            BevelType="Raised"
                            BorderThickness="{x:Static controls:Bevel.BorderThickness}">
                            <Border Background="{local:VatSysColour WindowBackground}" />
                        </controls:BeveledBorder>
                    </Border>
                </Grid>

                <!-- Scroll down button area -->
                <controls:Chevron
                    Grid.Row="2"
                    x:Name="PART_ScrollDownButton"
                    Width="13"
                    Height="13"
                    Margin="1,0,0,0"
                    Background="Transparent"
                    Direction="Down"
                    Foreground="{local:VatSysColour WindowBackground}"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom" />
            </Grid>
        </Border>
    </controls:BeveledBorder>
</UserControl>